# ---- LLM (Ollama, local) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ---- Web search ----
# Backend for the Web, Documentation, News, and Community agents.
#   tavily  = managed API, needs TAVILY_API_KEY (free tier at https://app.tavily.com)
#   searxng = free, self-hosted metasearch, no API key (run your own SearXNG)
SEARCH_PROVIDER=tavily

# -- Tavily (when SEARCH_PROVIDER=tavily) --
TAVILY_API_KEY=

# -- SearXNG (when SEARCH_PROVIDER=searxng) --
# Point at a running SearXNG instance with JSON output enabled in its settings.yml
# (search.formats: [html, json]). Quick start:
#   docker run -d --name searxng -p 8080:8080 searxng/searxng
# then edit its settings.yml to add "json" to search.formats and restart.
SEARXNG_URL=http://localhost:8080
# SearXNG returns snippets only; fetch top result pages to extract full text.
SEARXNG_FETCH_CONTENT=true
SEARXNG_FETCH_LIMIT=5
# Optional: restrict to specific upstream engines, e.g. google,bing,duckduckgo
SEARXNG_ENGINES=
SEARXNG_VERIFY_SSL=true

# ---- GitHub Research Agent (optional) ----
# A classic PAT (no scopes needed for public search) raises rate limits.
# Leave blank to use unauthenticated access (lower rate limit).
GITHUB_TOKEN=

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./researchmind.db

# ---- Knowledge base (semantic memory) ----
# Embeddings come from Ollama. Pull the model once: `ollama pull nomic-embed-text`.
# If the embedding model is unavailable, the app falls back to keyword search.
EMBEDDING_MODEL=nomic-embed-text
QDRANT_PATH=./qdrant_data
KNOWLEDGE_ENABLED=true

# ---- Server ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Security ----
# Per-client-IP request cap per minute (0 disables rate limiting).
RATE_LIMIT_PER_MINUTE=120
# Allow outbound fetches to private/localhost hosts (leave false in production).
ALLOW_PRIVATE_FETCH=false

# ---- Authentication (JWT) ----
# When false, the API runs as a single shared local account (no login required).
# Set true and change JWT_SECRET for any shared/networked deployment.
AUTH_ENABLED=true
# MUST be a long random string in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Set false to lock registration after the first (admin) account is created.
REGISTRATION_OPEN=true

# ---- Research budgets (Deep Research) ----
MAX_RESEARCH_TASKS=24
MAX_FOLLOWUP_ROUNDS=2
MAX_SOURCES_PER_TASK=5

# ---- Scheduled research (in-process poller) ----
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
# Floor on interval schedules to avoid runaway cadences.
MIN_SCHEDULE_INTERVAL_MINUTES=15

# ---- Market Intelligence mode ----
# How far back "recent" reaches when biasing search toward current information.
MARKET_RECENCY_DAYS=180
